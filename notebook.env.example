# manager-notebook 설정 예시
#
# 쓰는 법
#   1. 이 파일을 notebook.env 로 복사합니다.
#   2. 필요한 줄만 앞의 # 을 지우고 값을 적습니다.
#   3. docker run ... --env-file "$HOME\manager-notebook\notebook.env" ... 로 실행합니다(README).
#
# 꼭 지킬 것
#   - 값에 따옴표를 쓰지 마세요. 따옴표도 값으로 들어갑니다.
#   - '=' 앞뒤에 빈칸을 넣지 마세요.
#   - 값 뒤에 빈칸을 남기지 마세요. 빈칸도 값이 됩니다(특히 비밀번호).
#   - 주석(#)은 줄 맨 앞에만 씁니다. 값 뒤에 붙이면 값이 됩니다.
#   - 이 파일에는 비밀번호와 사내 주소가 들어갑니다. 내 폴더에만 두고, 공유하지 마세요.
#   - 값을 바꾼 뒤에는 컨테이너를 지우고 다시 만들어야 적용됩니다(README '설정 바꾸기').
#
# 아무것도 적지 않아도 동작합니다. 그때는 로그인 없음, 사내 AI 꺼짐입니다.

# ---------------------------------------------------------------
# 기본
# ---------------------------------------------------------------

# 시간대. 바꿀 일이 거의 없습니다.
TZ=Asia/Seoul

# ---------------------------------------------------------------
# 비밀번호(선택)
# ---------------------------------------------------------------
# 적으면 로그인 화면이 켜집니다. 비워 두면 로그인 없이 열립니다.
# 실행 명령에서 -p 127.0.0.1:8080:8080 을 쓰면 내 PC에서만 열립니다.
# 같은 PC를 다른 사람도 쓴다면 켜 두세요. 8자 이상으로 적으세요.
# 비밀번호를 켜도 연결은 암호화되지 않습니다. 다른 PC에서 열도록 바꾸지 마세요.
#NOTEBOOK_PASSWORD=여기에-긴-비밀번호

# ---------------------------------------------------------------
# 사내 AI(선택, 기본은 꺼짐)
# ---------------------------------------------------------------
# OpenAI 호환 주소(/v1/chat/completions 를 받는 곳)를 적으면 켜집니다.
# 주소 끝은 /v1 까지만 씁니다. 비우면 꺼집니다.
# 이 주소가 수첩이 밖으로 연결하는 유일한 곳입니다.
#LLM_BASE_URL=https://llm.example.internal/v1

# 사내 AI 키. 'Authorization: Bearer <키>' 로 보냅니다.
#LLM_API_KEY=

# 모델 이름. 사내 AI 담당 부서에 물어보세요.
#LLM_MODEL=

# 응답을 기다리는 최대 시간(초). 기본 90.
#LLM_TIMEOUT_SEC=90

# 사내 게이트웨이가 추가 헤더를 요구할 때만 씁니다.
# 형식: 이름1=값1;이름2=값2
#LLM_EXTRA_HEADERS=X-Team=example;X-Purpose=notebook

# ---------------------------------------------------------------
# 사내 인증서(사내 AI 주소가 https 이고, 회사 자체 인증서를 쓸 때)
# ---------------------------------------------------------------
# 인증서 파일(PEM, 첫 줄이 -----BEGIN CERTIFICATE-----)을 볼륨으로 넣고 그 경로를 적습니다.
# 시작 로그에 '사내 인증서 n개 읽음' 이 보이면 됩니다. 못 읽으면 경고가 남습니다.
# 실행할 때 -v C:\certs\company-ca.pem:/certs/company-ca.pem:ro 를 함께 붙입니다.
#SSL_CERT_FILE=/certs/company-ca.pem

# 마지막 수단입니다. 인증서 확인을 끕니다. 켜면 시작할 때 경고가 남습니다.
# 위의 SSL_CERT_FILE 을 먼저 써 보세요.
#LLM_INSECURE_SKIP_VERIFY=false

# ---------------------------------------------------------------
# 프록시(필요할 때만)
# ---------------------------------------------------------------
# 사내 AI 까지 프록시를 거쳐야 하면 적습니다.
#HTTPS_PROXY=http://proxy.example.internal:8080
# 반대로 Docker 설정 때문에 프록시가 들어오는데 사내 AI 는 프록시를 타면 안 되면,
# 사내 AI 호스트 이름을 적습니다.
#NO_PROXY=llm.example.internal
